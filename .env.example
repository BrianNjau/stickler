# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values belong here: they are
# inlined into the client bundle and are public by design.
#
# Service-role, Anthropic and Google keys live ONLY in Edge Function secrets
# (`supabase secrets set ...`). scripts/check-secrets.mjs fails CI if one leaks into app code.

# Hosted: https://<project-ref>.supabase.co   Local: http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# mock | live — mock until the Edge Function keys exist (see CLAUDE.md)
EXPO_PUBLIC_AI_MODE=mock
EXPO_PUBLIC_MAPS_MODE=mock
